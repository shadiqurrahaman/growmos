# ── Database ──────────────────────────────────────────────────────────────────
# Local Docker: postgres://growmos:growmos_secret@localhost:5432/growmos
# Neon (production): postgres://user:pass@ep-xxx.neon.tech/dbname?sslmode=require
DATABASE_URL=postgres://growmos:growmos_secret@localhost:5432/growmos

# ── Admin auth ────────────────────────────────────────────────────────────────
ADMIN_PASSWORD=shaon@123
AUTH_SECRET=your-random-secret-at-least-32-characters-long

# ── SMTP (outgoing email) ─────────────────────────────────────────────────────
# cPanel hosting: host is usually mail.yourdomain.com
SMTP_HOST=mail.growmos.com
SMTP_PORT=465
SMTP_USER=hello@growmos.com
SMTP_PASS=your-cpanel-email-password
CONTACT_TO=hello@growmos.com
EMAIL_FROM_NAME=GrowMos

# ── IMAP (inbox reading) ──────────────────────────────────────────────────────
# cPanel hosting: same host as SMTP, port 993 for SSL
IMAP_HOST=mail.growmos.com
IMAP_PORT=993
IMAP_USER=hello@growmos.com
IMAP_PASS=your-cpanel-email-password

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ── Google Analytics ──────────────────────────────────────────────────────────
# Get your Measurement ID from https://analytics.google.com (format: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ── EmailJS (contact form delivery) ───────────────────────────────────────────
# Get these from https://dashboard.emailjs.com/
# Create an Email Service (e.g. Gmail), then a template whose "To Email" is
# alenfab06@gmail.com and whose template variables are:
#   {{from_name}}, {{reply_to}}, {{phone}}, {{service}}, {{message}}
NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_xxxxxxx
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=template_xxxxxxx
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=public_key_xxxxxxx

# ── Vercel Blob (for image uploads, optional) ─────────────────────────────────
BLOB_READ_WRITE_TOKEN=vercelblob_...

# ── Cloudinary (for image uploads, optional) ──────────────────────────────────
# Sign up free at https://cloudinary.com — 25 GB free tier.
# Get cloud_name / api_key / api_secret from the Console Dashboard home.
# Create an UNSIGNED upload preset named e.g. "growmos_blog" with folder "growmos/blogs".
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_UPLOAD_PRESET=growmos_blog
